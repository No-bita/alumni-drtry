{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "perf:budget": "node ./scripts/check-performance-budgets.mjs",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "perf:lighthouse:mobile": "lhci autorun --config=./lighthouserc.mobile.json",
    "perf:ci": "npm run build && npm run perf:budget && npm run perf:lighthouse && npm run perf:lighthouse:mobile"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "qs": "^6.16.1"
  }
}
