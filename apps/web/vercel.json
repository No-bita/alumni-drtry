{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/v1/:path*",
      "has": [{ "type": "host", "value": "app.almamater.aaryanshah.co.in" }],
      "destination": "https://almamatter.in/v1/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.almamater.aaryanshah.co.in" }],
      "destination": "https://almamatter.in/app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.almamatter.in" }],
      "destination": "https://almamatter.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "https://alma-mater-api.onrender.com/v1/$1"
    },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/((?!assets/).*)", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/((?!app/media/World_Map_Vns\\.html$|app(?:/(?!media/|assets/).*)?$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://alma-mater-api.onrender.com https://api.bigdatacloud.net; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; worker-src 'self' blob:; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/app(/(?!media/|assets/).*)?",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://alma-mater-api.onrender.com https://api.bigdatacloud.net; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; worker-src 'self' blob:; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/app/media/World_Map_Vns.html",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'none'; script-src 'sha256-8pnG7Zor/ax26QS8o22s+T7kKKyv/1KNOBYFDSsfznU=' 'sha256-cOoby5JuJ0ikLuuoSYNPkXkdLdppez57Ji0IDP1wg8g=' https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js https://cdn.jsdelivr.net/npm/topojson-client@3/+esm; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/((?!app/media/World_Map_Vns\\.html$).*)",
      "headers": [{ "key": "X-Frame-Options", "value": "DENY" }]
    },
    {
      "source": "/app/media/World_Map_Vns.html",
      "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }]
    },
    {
      "source": "/app/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/app",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/v1/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-vercel-trusted-oidc-idp-token"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-vercel-oidc-token"
          }
        },
        {
          "type": "response.headers",
          "op": "delete",
          "target": {
            "key": "x-vercel-trusted-oidc-idp-token"
          }
        },
        {
          "type": "response.headers",
          "op": "delete",
          "target": {
            "key": "x-vercel-oidc-token"
          }
        }
      ]
    }
  ]
}
