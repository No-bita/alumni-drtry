# API base URL (origin only — no trailing slash, no /healthz).
#
# Local dev: leave empty so Vite proxies /v1 → http://localhost:4000 (apps/api must be running).
#
# Vercel: leave empty if vercel.json rewrites /v1 to your Railway API (same-origin, no CORS).
# Or set VITE_API_URL to call the API directly (then set API CORS_ORIGIN to your Vercel URL).
#
VITE_API_URL=

# Homepage feedback strip — optional override for the Google Form URL (defaults to repo placeholder if unset).
# VITE_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/xxxxxxxx/viewform

# Production beta (invite code UI): set to "true" on Vercel for builds that use invite-code sign-in.
# VITE_BETA_INVITE_AUTH_ENABLED=true
