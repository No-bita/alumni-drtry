# API base URL (origin only — no trailing slash, no /healthz).
#
# Local dev: leave empty so Vite proxies /v1 → http://localhost:4000 (apps/api must be running).
#
# Vercel / production: set in the dashboard (Environment Variables) and redeploy, e.g.:
# VITE_API_URL=https://your-api.up.railway.app
#
# On the API host, set CORS_ORIGIN to your frontend URL (e.g. https://your-app.vercel.app).
VITE_API_URL=
