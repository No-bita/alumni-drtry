# Alma Mater landing page — optional environment variables.
# Copy to .env.local for local overrides. Never commit a real .env file.

# Public origin of this landing page (e.g. https://your-domain). Used as the base URL for the
# share image in Open Graph / Twitter tags. Optional on Vercel, where Next.js falls back to the
# project's production URL.
NEXT_PUBLIC_SITE_URL=
