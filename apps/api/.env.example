# Copy to `.env` and fill values. Never commit `.env`.
#
# --- Use the SAME database as production (local API parity) ---
# Set `DATABASE_URL` to your hosted Postgres URL (same variable Railway/Neon uses in prod).
# From a laptop, prefer Neon’s pooler URL or Railway’s DATABASE_PUBLIC_URL (not *.railway.internal).
# Lower pool size when pointing at prod so you don’t exhaust connections:
#   DATABASE_POOL_MAX=5
#
# CRITICAL: If `DATABASE_URL` is production, `AUTH_SECRET_PEPPER` MUST match production.
# Otherwise sessions, OTP secrets, and password hashes will not line up with stored rows.
#
# For web on http://localhost:5173:
#   CORS_ORIGIN=http://localhost:5173
#   MAGIC_LINK_BASE_URL=http://localhost:5173
#
# Copy beta / invite / Google / Resend keys from prod only if you need identical auth behavior.

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
MAGIC_LINK_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_POOL_MAX=5

AUTH_SECRET_PEPPER=change_me_min_16_chars_use_prod_value_if_using_prod_db

CORS_ORIGIN=http://localhost:5173
EMAIL_PROVIDER=console

# Optional: align with production (copy from host env when debugging prod-only behavior)
# BETA_INVITE_AUTH_ENABLED=false
# BETA_REQUIRE_ALLOWLIST=true
# BETA_SHARED_INVITE_CODE_HASH=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=

# WhatsApp pilot (off by default; see docs/whatsapp-setup.md)
# WHATSAPP_ENABLED=false
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=
# WA_BOT_NUMBER=919876543210
# WA_TEMPLATE_NOTE=alum_referral_note
# WA_TEMPLATE_LANG=en
# WA_MONTHLY_TEMPLATE_CAP=300
# WA_GRAPH_VERSION=v23.0

# Cities v1 (Bengaluru first). Unset → Bengaluru, India is looked up by name.
# CITIES_V1_PLACE_IDS=<canonical place uuid>[,<another>]
# Chapter group card on a city page (optional): JSON keyed by canonical place id.
# CITY_CHAPTER_LINKS={"<place uuid>":{"url":"https://chat.whatsapp.com/...","label":"Join the Bengaluru chapter group"}}
