NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
# Optional: base URL for magic links (e.g. frontend). If set, links point here instead of APP_BASE_URL.
# MAGIC_LINK_BASE_URL=http://localhost:5173
# PostgreSQL. For Neon: use connection string from Neon Console (includes ?sslmode=require). See docs/neon-setup.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alumni
# Pool (pg.Pool): tune per process; with Neon pooler / serverless, use a small max per instance.
# DATABASE_POOL_MAX=20
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# Directory search: PostgreSQL statement_timeout (ms) for the search SELECT only. 0 = no limit.
# DISCOVERY_SEARCH_STATEMENT_TIMEOUT_MS=15000
# Parse q for year/dept/org aliases into structured params (MVP). Default false.
# DISCOVERY_NORMALIZE_QUERY=false
# Record discovery_search_sessions + profile clicks (migration 015). Default true.
# DISCOVERY_ANALYTICS_ENABLED=true
ALLOWED_EMAIL_DOMAINS=iitbhu.ac.in,itbhu.ac.in
SESSION_COOKIE_NAME=alumni_session
# Sliding session: extend expiry on activity (hours). Hard cap from session created_at (hours). Throttle DB touch (seconds).
# SESSION_SLIDING_HOURS=4
# SESSION_HARD_CAP_HOURS=48
# SESSION_TOUCH_MIN_INTERVAL_SECONDS=120
OTP_TTL_MINUTES=10
MAGIC_LINK_TTL_MINUTES=15
AUTH_CHALLENGE_MAX_ATTEMPTS=5
AUTH_START_MAX_PER_EMAIL_WINDOW=3
AUTH_START_MAX_PER_IP_WINDOW=20
AUTH_START_WINDOW_MINUTES=10
AUTH_SECRET_PEPPER=change_me_to_random_secret
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=
EMAIL_BRAND_NAME=IIT BHU Alumni Network
RESEND_API_KEY=
SHOW_AUTH_SECRETS_IN_RESPONSE=false
# Dev: * is OK. Production: comma-separated HTTPS origins — never * (see env validation in apps/api/src/config/env.ts).
CORS_ORIGIN=*
# Non-production only: treat API requests without a session cookie as the super_admin with this email.
# Must match migration 007 seed (see apps/api/src/db/migrations/007_super_admin.sql).
# AUTH_BYPASS_SUPER_ADMIN=true
# AUTH_BYPASS_SUPER_ADMIN_EMAIL=seed-admin-placeholder@example.invalid
# Optional: Sentry DSN for error monitoring. If unset, errors are only logged.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Days the author still sees a “removed” bulletin post + replies before hard delete (default 30).
# INTENTCAST_AUTHOR_DELETE_RETENTION_DAYS=7
# Abuse limits: max outgoing contact requests per sender within window (0 = unlimited).
# CONTACT_REQUEST_MAX_PER_SENDER_WINDOW=25
# CONTACT_REQUEST_WINDOW_MINUTES=1440
# Directory: max combined reads per user per window (search + profile + demo-profiles). In-memory per API instance. 0 = off.
# DISCOVERY_READ_MAX_PER_USER_WINDOW=150
# DISCOVERY_READ_WINDOW_MINUTES=1
# Optional shared-IP cap (same window). 0 = off.
# DISCOVERY_READ_MAX_PER_IP_WINDOW=0

# Sign in with Google (OAuth 2.0). Create OAuth client credentials in Google Cloud Console
# (Web application). Authorized redirect URI must match exactly:
#   {APP_BASE_URL}/v1/auth/google/callback
# Example: http://localhost:4000/v1/auth/google/callback
# Set both, or omit both, to disable the feature.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: Google OAuth `hd` — single Google Workspace domain (e.g. itbhu.ac.in). Biases the account picker only;
# allowed sign-in emails are still enforced by ALLOWED_EMAIL_DOMAINS after Google returns the account.
# GOOGLE_OAUTH_HOSTED_DOMAIN=itbhu.ac.in