# Copy to `.env` and fill values. Never commit `.env`.
#
# --- Use the SAME database as production (local API parity) ---
# Set `DATABASE_URL` to your hosted Postgres URL (same variable Railway/Neon uses in prod).
# From a laptop, prefer Neon’s pooler URL or Railway’s DATABASE_PUBLIC_URL (not *.railway.internal).
# Lower pool size when pointing at prod so you don’t exhaust connections:
#   DATABASE_POOL_MAX=5
#
# CRITICAL: If `DATABASE_URL` is production, `AUTH_SECRET_PEPPER` MUST match production.
# Otherwise sessions, OTP secrets, and password hashes will not line up with stored rows.
#
# For web on http://localhost:5173 (the app is served under /app):
#   CORS_ORIGIN=http://localhost:5173
#   WEB_APP_URL=http://localhost:5173/app
#
# Production (app at almamatter.in/app, API reached through almamatter.in/v1):
#   APP_BASE_URL=https://almamatter.in          (public API base; Google callback = APP_BASE_URL/v1/auth/google/callback)
#   WEB_APP_URL=https://almamatter.in/app       (every member-facing link: sign-in emails, Google return, WhatsApp, city emails)
#   CORS_ORIGIN=https://almamatter.in,https://app.almamater.aaryanshah.co.in   (old origin only during the cut-over)
#
# Copy beta / invite / Google / Resend keys from prod only if you need identical auth behavior.

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
# Older name MAGIC_LINK_BASE_URL is still read when WEB_APP_URL is unset.
WEB_APP_URL=http://localhost:5173/app

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_POOL_MAX=5

AUTH_SECRET_PEPPER=change_me_min_16_chars_use_prod_value_if_using_prod_db

CORS_ORIGIN=http://localhost:5173
EMAIL_PROVIDER=console

# Optional: align with production (copy from host env when debugging prod-only behavior)
# BETA_REQUIRE_ALLOWLIST=true
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=

# Admin announcements: email send rate (per second, default 1; keep it below the
# provider's API limit so sign-in emails still go through during a send) and worker interval in ms
# (default 30000 in production, off elsewhere; set e.g. 15000 to send locally).
# ANNOUNCEMENT_EMAILS_PER_SECOND=1
# ANNOUNCEMENT_WORKER_MS=

# WhatsApp pilot (off by default; see docs/whatsapp-setup.md)
# WHATSAPP_ENABLED=false
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=
# WA_BOT_NUMBER=919876543210
# WA_TEMPLATE_NOTE=alum_referral_note
# WA_TEMPLATE_LANG=en
# WA_MONTHLY_TEMPLATE_CAP=300
# WA_GRAPH_VERSION=v23.0

# City review (docs/city-review.md). Off by default: unknown typed cities stay as typed text and the
# admin queue (/admin/cities) answers 404. Safe combining, history and hiding non-approved cities apply either way.
# CITY_REVIEW_ENABLED=true

# Chapter group card on a city page (optional): JSON keyed by canonical place id.
# CITY_CHAPTER_LINKS={"<place uuid>":{"url":"https://chat.whatsapp.com/...","label":"Join the Bengaluru chapter group"}}

# Security hardening (docs/security-hardening.md)
# Client IP behind proxies. Unset: 2 hops in production (browser -> Vercel rewrite -> Render -> API), none elsewhere.
# TRUST_PROXY=2
# Browsing limits (anti-scraping), per member, stored in the database; admins aren't counted. 0 = off.
# DISCOVERY_READ_MAX_PER_USER_WINDOW=60      # per UTC minute
# DISCOVERY_READ_MAX_PER_USER_DAY=500        # per day, midnight Asia/Kolkata
# DISCOVERY_READ_MAX_PER_IP_WINDOW=300       # per client IP per minute (in memory)
# AUTH_VERIFY_MAX_PER_IP_WINDOW=60           # sign-in code/link checks per client IP per 10 minutes
# WhatsApp website links (/w/<code>) stay valid this long.
# WA_LINK_TOKEN_TTL_MINUTES=120
# ENABLE_PASSWORD_LOGIN is refused in production.
